{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "CI_BUILD": "OFF",
                "GPL_BUILD": "OFF",
                "STATIC_ACTS": "OFF",
                "ALL_PLATFORM_ACTS": "OFF",
                "NO_QT_BUILD": "OFF"
            }
        },
        {
            "name": "default",
            "inherits": "base",
            "generator": "Visual Studio 18 2026",
            "toolset": "v143",
            "architecture": "x64"
        },
        {
            "name": "ci",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CI_BUILD": "ON"
            }
        },
        {
            "name": "gpl",
            "inherits": "default",
            "cacheVariables": {
                "GPL_BUILD": "ON"
            }
        },
        {
            "name": "ci-gpl",
            "inherits": "ci",
            "cacheVariables": {
                "GPL_BUILD": "ON"
            }
        }
    ]
}
