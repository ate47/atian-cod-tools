/* an AI wrote that */

QWidget
{
    background: #F3F3F3;
    qproperty-background: #F3F3F3;
    color: #1F1F1F;
    font-family: "Segoe UI";
    font-size: 9pt;
}

QWidget:disabled
{
    color: #A0A0A0;
}

QMdiArea
{
    background: #A3A3A3;
    qproperty-background: #A3A3A3;
}

QToolTip
{
    background: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #CFCFCF;
    padding: 4px;
}

/* ------------------------------------------------------
   Buttons
   ------------------------------------------------------ */

QPushButton
{
    background: #FFFFFF;
    border: 1px solid #D6D6D6;
    border-radius: 6px;
    padding: 6px 16px;
    min-height: 24px;
}

QPushButton:hover
{
    background: #F8F8F8;
    border: 1px solid #CFCFCF;
}

QPushButton:pressed
{
    background: #EDEDED;
}

QPushButton:disabled
{
    background: #F5F5F5;
    color: #9C9C9C;
    border: 1px solid #E5E5E5;
}

/* Accent button */

QPushButton#accentButton
{
    background: #00D478;
    color: white;
    border: none;
}

QPushButton#accentButton:hover
{
    background: #106EBE;
}

QPushButton#accentButton:pressed
{
    background: #005EA6;
}

/* ------------------------------------------------------
   Text Inputs
   ------------------------------------------------------ */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox
{
    background: white;
    border: 1px solid #C5C5C5;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #CCE4F7;
    selection-color: black;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus
{
    border: 2px solid #00D478;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled
{
    background: #F5F5F5;
}

/* ------------------------------------------------------
   ComboBox / SpinBox
   ------------------------------------------------------ */

QComboBox
{
    padding-right: 20px;
}

QComboBox::drop-down
{
    border: none;
}

QComboBox QAbstractItemView
{
    background: white;
    border: 1px solid #DADADA;
    selection-background-color: #CCE4F7;
    selection-color: black;
    outline: none;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button
{
    background: transparent;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover
{
    background: #E8E8E8;
}

/* ------------------------------------------------------
   CheckBoxes / RadioButtons
   ------------------------------------------------------ */

QCheckBox,
QRadioButton
{
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator
{
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked
{
    background: white;
    border: 1px solid #8A8A8A;
    border-radius: 4px;
}

QCheckBox::indicator:unchecked:hover
{
    border: 1px solid #5A5A5A;
}

QRadioButton::indicator:unchecked
{
    background: white;
    border: 1px solid #8A8A8A;
    border-radius: 9px;
}

QRadioButton::indicator:checked
{
    background: #00D478;
    border: 4px solid white;
    outline: 1px solid #00D478;
    border-radius: 9px;
}

QCheckBox::indicator:checked
{
    image: url(:/images/check.svg);
    background: #00D478;
    border: 1px solid #00D478;
    border-radius: 4px;
}

/* ------------------------------------------------------
   Slider / Progress
   ------------------------------------------------------ */

QSlider::groove:horizontal
{
    height: 4px;
    background: #D0D0D0;
    border-radius: 2px;
}

QSlider::sub-page:horizontal
{
    background: #00D478;
    border-radius: 2px;
}

QSlider::handle:horizontal
{
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    background: #00D478;
}

QProgressBar
{
    background: #E3E3E3;
    border: none;
    border-radius: 3px;
    text-align: center;
    min-height: 6px;
}

QProgressBar::chunk
{
    background: #00D478;
    border-radius: 3px;
}

/* ------------------------------------------------------
   Group Box
   ------------------------------------------------------ */

QGroupBox
{
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    background: #FBFBFB;
}

QGroupBox::title
{
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

/* ------------------------------------------------------
   Tree / List / Table
   ------------------------------------------------------ */

QTreeView,
QTableView,
QListView
{
    background: white;
    border: 1px solid #D8D8D8;
    border-radius: 6px;
    alternate-background-color: #F8F8F8;
    outline: none;
}

QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover
{
    background: #EEF5FC;
}

QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected
{
    background: #CCE4F7;
    color: black;
}

QHeaderView::section
{
    background: #F6F6F6;
    border: none;
    border-bottom: 1px solid #D8D8D8;
    padding: 6px;
}

/* ------------------------------------------------------
   Tabs
   ------------------------------------------------------ */

QTabWidget::pane
{
    border: 1px solid #D8D8D8;
    border-radius: 6px;
    background: white;
}

QTabBar::tab
{
    background: transparent;
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected
{
    border-bottom: 2px solid #00D478;
}

QTabBar::tab:hover
{
    background: #F3F3F3;
}

/* ------------------------------------------------------
   Scrollbars
   ------------------------------------------------------ */

QScrollBar:vertical
{
    border: none;
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical
{
    background: #C8C8C8;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover
{
    background: #AFAFAF;
}

QScrollBar::add-line,
QScrollBar::sub-line
{
    height: 0;
    width: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page
{
    background: transparent;
}

QScrollBar:horizontal
{
    border: none;
    background: transparent;
    height: 12px;
}

QScrollBar::handle:horizontal
{
    background: #C8C8C8;
    border-radius: 6px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover
{
    background: #AFAFAF;
}

/* ------------------------------------------------------
   Menus
   ------------------------------------------------------ */

QMenuBar
{
    background: #F3F3F3;
}

QMenuBar::item
{
    padding: 4px 10px;
    border-radius: 4px;
    background: transparent;
}

QMenuBar::item:selected
{
    background: #E5E5E5;
}

QMenu
{
    background: white;
    border: 1px solid #DADADA;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item
{
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected
{
    background: #E8F3FF;
}

QMenu::separator
{
    height: 1px;
    background: #E0E0E0;
    margin: 4px 8px;
}
