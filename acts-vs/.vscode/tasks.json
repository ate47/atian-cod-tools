// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "gscCompiler",
      "type": "promptString",
      "description": "Path to the acts executable",
      "default": "acts.exe"
    },
    {
      "id": "gscGame",
      "type": "promptString",
      "description": "Game identifier passed to gscc",
      "default": "bo4"
    }
  ]
}
